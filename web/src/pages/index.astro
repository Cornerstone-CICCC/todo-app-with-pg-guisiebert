---
const API = "http://localhost:3001";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Todo App</title>
  </head>
  <body>
    <main class="card">
      <h1>Todo App</h1>

      <form id="add-form">
        <input id="new-task" placeholder="Add a new todo" autocomplete="off" />
        <button type="submit">Add Todo</button>
      </form>

      <ul id="list"></ul>
    </main>

    <script define:vars={{ API }}>
      const list = document.getElementById("list");
      let editingId = null;

      async function load() {
        const res = await fetch(`${API}/todos`);
        render(await res.json());
      }

      function render(todos) {
        list.innerHTML = "";

        for (const todo of todos) {
          const li = document.createElement("li");

          if (todo.id === editingId) {
            const input = document.createElement("input");
            input.value = todo.task;

            const save = document.createElement("button");
            save.textContent = "Save";
            save.onclick = async () => {
              await update(todo.id, { task: input.value });
              editingId = null;
              load();
            };

            li.append(input, save);
          } else {
            const check = document.createElement("input");
            check.type = "checkbox";
            check.checked = todo.done;
            check.onchange = () => update(todo.id, { done: check.checked }).then(load);

            const text = document.createElement("span");
            text.textContent = todo.task;
            if (todo.done) text.classList.add("done");

            const edit = document.createElement("button");
            edit.textContent = "✏️";
            edit.onclick = () => {
              editingId = todo.id;
              load();
            };

            const del = document.createElement("button");
            del.textContent = "🗑️";
            del.onclick = async () => {
              await fetch(`${API}/todos/${todo.id}`, { method: "DELETE" });
              load();
            };

            li.append(check, text, edit, del);
          }

          list.append(li);
        }
      }

      function update(id, body) {
        return fetch(`${API}/todos/${id}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
      }

      document.getElementById("add-form").onsubmit = async (e) => {
        e.preventDefault();
        const input = document.getElementById("new-task");
        if (!input.value.trim()) return;

        await fetch(`${API}/todos`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ task: input.value.trim() }),
        });
        input.value = "";
        load();
      };

      load();
    </script>

    <style is:global>
      body {
        font-family: system-ui, sans-serif;
        background: #f1f3f5;
        margin: 0;
        padding: 2rem;
      }
      .card {
        max-width: 700px;
        margin: 0 auto;
        background: #fff;
        border-radius: 12px;
        padding: 2rem;
      }
      h1 {
        text-align: center;
      }
      form {
        display: flex;
        gap: 0.5rem;
      }
      input {
        flex: 1;
        padding: 0.6rem;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 1rem;
      }
      button {
        padding: 0.6rem 1rem;
        border: 1px solid #ccc;
        border-radius: 8px;
        background: #fff;
        cursor: pointer;
        font-size: 1rem;
      }
      #add-form button {
        background: #111;
        color: #fff;
        border-color: #111;
      }
      ul {
        list-style: none;
        padding: 0;
        margin-top: 1.5rem;
      }
      li {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background: #f8f9fa;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        margin-bottom: 0.75rem;
      }
      li span {
        flex: 1;
      }
      .done {
        text-decoration: line-through;
        color: #888;
      }
      input[type="checkbox"] {
        flex: none;
        width: 18px;
        height: 18px;
      }
    </style>
  </body>
</html>
